# Copy to .env and fill in. NEVER commit the real .env file.
POSTGRES_DB=iris
POSTGRES_USER=iris_user
POSTGRES_PASSWORD=change_me

# Host-side connection (docker-compose maps Postgres to port 5433)
DATABASE_URL=postgresql+psycopg2://iris_user:change_me@localhost:5433/iris

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
